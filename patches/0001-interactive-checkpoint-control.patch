+        {"host-action-arg",1,0,HOSTARG}, {"help",0,0,'h'}, {0,0,0,0}
     };
     a->timeout_s = 300; a->action_timeout_s = 300; a->hold_ms = 200;
-    a->cfg.cntlid = UINT_MAX;
