                 if (intent_at) {
                     uint64_t until=now_ms()+5000;
@@ -274,6 +299,8 @@
         snprintf(value,sizeof(value),"%llu",(unsigned long long)a->cfg.epoch);
         setenv("UVP_EPOCH",value,1);
         puts("ACTION_EXEC: QEMU released; guest command may now wait for guest readiness");
